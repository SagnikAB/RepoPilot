# Copy to .env and adjust. All variables use the REPOPILOT_ prefix.
# Never put tokens or credentials in this file. Values shown are the defaults.

# development | test | production
REPOPILOT_ENVIRONMENT=development
REPOPILOT_LOG_LEVEL=INFO

# JSON list of origins allowed to call the API (the Next.js frontend).
REPOPILOT_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Ingestion -----------------------------------------------------------------
# JSON list of hosts accepted in https://<host>/<owner>/<repo> URLs.
REPOPILOT_ALLOWED_GIT_HOSTS=["github.com"]
REPOPILOT_GIT_EXECUTABLE=git
# Parent directory for temporary clone workspaces (system temp dir if unset).
# REPOPILOT_WORKSPACE_ROOT=/var/tmp/repopilot
REPOPILOT_CLONE_TIMEOUT_SECONDS=60
# Clone is aborted once the workspace (including .git) exceeds this many bytes.
REPOPILOT_MAX_CLONE_BYTES=262144000

# --- File filtering --------------------------------------------------------------
REPOPILOT_MAX_FILES_SCANNED=50000
REPOPILOT_MAX_SOURCE_FILES=5000
REPOPILOT_MAX_FILE_BYTES=1048576
REPOPILOT_MAX_TOTAL_SOURCE_BYTES=52428800

# --- Parsing ---------------------------------------------------------------------
# subprocess (recommended): Tree-sitter runs in a worker process so native
# crashes and hangs cannot take down the API. inprocess: tests/debugging only.
REPOPILOT_PARSE_ISOLATION=subprocess
REPOPILOT_PARSE_TIME_BUDGET_SECONDS=120
REPOPILOT_PARSE_FILE_TIMEOUT_SECONDS=15
REPOPILOT_MAX_SYNTAX_NODES_PER_FILE=1000000
REPOPILOT_MAX_PARSE_ERRORS_PER_FILE=5

# --- Rules -----------------------------------------------------------------------
REPOPILOT_MAX_FINDINGS_PER_FILE=100

# --- Call graph ------------------------------------------------------------------
REPOPILOT_MAX_GRAPH_NODES=100000
REPOPILOT_MAX_GRAPH_EDGES=500000

# --- Analysis --------------------------------------------------------------------
# POST /api/analyze is synchronous; extra concurrent requests get 429.
REPOPILOT_MAX_CONCURRENT_ANALYSES=2

# --- Storage ---------------------------------------------------------------------
# In-memory analyses kept at once (least recently used is evicted).
REPOPILOT_MAX_STORED_ANALYSES=20
# Total retained source text across stored analyses (bytes); LRU eviction beyond it.
REPOPILOT_MAX_STORED_SOURCE_BYTES=268435456

# --- Diagnostics -----------------------------------------------------------------
REPOPILOT_MAX_DIAGNOSTIC_ITEMS=200
