# RepoPilot Web Environment Configuration
# Copy this file to .env.local for local overrides. Do not commit actual secrets.

# URL of the RepoPilot Python analyzer backend service
# Default: http://127.0.0.1:8000
ANALYZER_API_URL=http://127.0.0.1:8000

# OpenAI API key for evidence-backed investigation assistant (optional for graph exploration)
# When omitted, the UI indicates that AI investigation is unconfigured rather than returning fabricated answers.
OPENAI_API_KEY=your-openai-api-key-here

# Optional: custom OpenAI base URL (e.g., for Azure, local Ollama, or vLLM proxy)
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name to use for investigations
# Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
